# we-code 本地配置模板
# 使用方式：复制为 wecode.yml 后按需修改。
#   copy wecode.yml.example wecode.yml
#
# 本模板不填写真实 API Key。复制为被 Git 忽略的 wecode.yml 后，可在各 Provider 的 api-key 填写。

storage:
  root: "C:/Users/<你的用户名>/AppData/Local/wecode"

llm:
  # 只修改此项即可在下方已定义的 Provider 档案之间切换。
  active-provider: deepseek

  providers:
    deepseek:
      # 同一 protocol 的 Provider 共用 Java 适配器；新增兼容服务只需新增一个配置节点。
      protocol: openai-chat-completions
      base-url: https://api.deepseek.com
      api-key: ""
      model: deepseek-v4-flash
      thinking:
        # DeepSeek 工具调用的思考链会自动保存并在下一轮请求中回传。
        enabled: true
        reasoning-effort: high
        response-field: reasoning_content
        send-toggle: true

    openai:
      protocol: openai-chat-completions
      base-url: https://api.openai.com/v1
      api-key: ""
      model: gpt-5.6-terra
      temperature: 0.2
