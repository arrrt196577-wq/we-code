<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.wecode</groupId>
    <artifactId>we-code</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>we-code</name>
    <description>Lightweight coding agent framework</description>

    <modules>
        <module>id</module>
        <module>cli</module>
        <module>agent</module>
        <module>tools</module>
        <module>llm</module>
        <module>session</module>
        <module>permission</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <we-code.version>1.0-SNAPSHOT</we-code.version>
        <jackson.version>2.22.1</jackson.version>
        <picocli.version>4.7.7</picocli.version>
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <sqlite-jdbc.version>3.53.1.0</sqlite-jdbc.version>
        <flyway.version>13.1.0</flyway.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-nc-sqlite</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>5.11.4</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.wecode</groupId>
                <artifactId>id</artifactId>
                <version>${we-code.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wecode</groupId>
                <artifactId>cli</artifactId>
                <version>${we-code.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wecode</groupId>
                <artifactId>agent</artifactId>
                <version>${we-code.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wecode</groupId>
                <artifactId>tools</artifactId>
                <version>${we-code.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wecode</groupId>
                <artifactId>llm</artifactId>
                <version>${we-code.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wecode</groupId>
                <artifactId>session</artifactId>
                <version>${we-code.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wecode</groupId>
                <artifactId>permission</artifactId>
                <version>${we-code.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 统一使用支持 JUnit 5 的 Surefire，避免子模块测试被旧默认版本跳过。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

</project>
